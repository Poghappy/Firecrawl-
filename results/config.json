{
  "firecrawl": {
    "api_key": "fc_test_key_placeholder_12345",
    "base_url": "https://api.firecrawl.dev",
    "timeout": 30,
    "max_retries": 3,
    "retry_delay": 1.0
  },
  "processing": {
    "enable_content_cleaning": true,
    "enable_keyword_extraction": true,
    "enable_auto_categorization": true,
    "enable_summary_generation": true,
    "min_content_length": 100,
    "max_content_length": 50000,
    "quality_threshold": 0.6,
    "language_detection": true,
    "duplicate_detection": true
  },
  "api_integration": {
    "base_url": "https://hawaiihub.net/api/",
    "api_key": "hn_test_key_placeholder_12345",
    "timeout": 30,
    "max_retries": 3,
    "retry_delay": 2.0,
    "default_category_id": 1,
    "default_author_id": 1,
    "auto_publish": false,
    "rate_limit": {
      "requests_per_minute": 60,
      "requests_per_hour": 1000
    }
  },
  "task_scheduler": {
    "max_concurrent_tasks": 5,
    "task_timeout": 300,
    "cleanup_interval": 3600,
    "max_task_history": 1000,
    "enable_persistence": true,
    "storage_backend": "file",
    "redis_config": {
      "host": "localhost",
      "port": 6379,
      "db": 0,
      "password": null
    }
  },
  "caching": {
    "enable_cache": true,
    "cache_ttl": 3600,
    "max_cache_size": 1000,
    "cache_backend": "memory"
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file_path": "logs/firecrawl_collector.log",
    "max_file_size": "10MB",
    "backup_count": 5,
    "enable_console": true
  },
  "storage": {
    "output_directory": "data/collected",
    "backup_directory": "data/backup",
    "temp_directory": "data/temp",
    "enable_compression": true,
    "auto_cleanup": true,
    "cleanup_days": 30
  },
  "sources": [
    {
      "name": "firecrawl_blog",
      "url": "https://firecrawl.dev/blog",
      "type": "crawl",
      "enabled": true,
      "schedule": "0 */6 * * *",
      "max_pages": 50,
      "crawl_options": {
        "excludePaths": ["/admin/*", "/private/*"],
        "includePaths": ["/blog/*", "/news/*"],
        "maxDepth": 3,
        "limit": 100
      },
      "processing_options": {
        "auto_categorize": true,
        "extract_keywords": true,
        "generate_summary": true,
        "quality_filter": true
      }
    },
    {
      "name": "firecrawl_docs",
      "url": "https://docs.firecrawl.dev",
      "type": "crawl",
      "enabled": true,
      "schedule": "0 0 * * 0",
      "max_pages": 100,
      "crawl_options": {
        "excludePaths": ["/api-reference/*"],
        "includePaths": ["/introduction", "/quickstart", "/guides/*"],
        "maxDepth": 4,
        "limit": 200
      },
      "processing_options": {
        "auto_categorize": true,
        "extract_keywords": true,
        "generate_summary": true,
        "quality_filter": true,
        "category_override": "文档"
      }
    },
    {
      "name": "single_page_example",
      "url": "https://example.com/important-article",
      "type": "single",
      "enabled": false,
      "schedule": "0 12 * * *",
      "processing_options": {
        "auto_categorize": false,
        "category_override": "重要新闻",
        "priority": "high",
        "auto_publish": true
      }
    }
  ],
  "notifications": {
    "enable_email": true,
    "email_config": {
      "smtp_server": "smtp.gmail.com",
      "smtp_port": 587,
      "username": "your_email@gmail.com",
      "password": "your_app_password",
      "from_email": "noreply@hawaiihub.net",
      "to_emails": ["admin@hawaiihub.net"],
      "template_path": "templates/email",
      "include_ai_analysis": true,
      "include_diff": true
    },
    "enable_webhook": true,
    "webhook_config": {
      "url": "https://hawaiihub.net/api/webhook/firecrawl",
      "secret": "your_webhook_secret",
      "events": ["content_changed", "task_completed", "task_failed", "system_error"],
      "retry_attempts": 3,
      "timeout": 30
    },
    "enable_dashboard": true,
    "dashboard_config": {
      "port": 8081,
      "enable_auth": true,
      "username": "admin",
      "password": "your_dashboard_password"
    }
  },
  "monitoring": {
    "enable_metrics": true,
    "metrics_port": 8080,
    "health_check_interval": 60,
    "performance_tracking": true,
    "error_tracking": true,
    "change_detection": {
      "enabled": true,
      "check_interval": 3600,
      "content_hash_algorithm": "sha256",
      "ai_filtering": {
        "enabled": true,
        "provider": "openai",
        "api_key": "your_openai_api_key_here",
        "model": "gpt-3.5-turbo",
        "threshold": 50,
        "max_tokens": 1000
      },
      "notification_rules": {
        "immediate_notify": ["critical", "breaking_news"],
        "batch_notify": ["normal", "low_priority"],
        "batch_interval": 1800
      }
    }
  },
  "security": {
    "enable_ssl_verification": true,
    "user_agent": "FirecrawlCollector/1.0",
    "request_headers": {
      "Accept": "application/json",
      "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8"
    },
    "proxy_config": {
      "enable_proxy": false,
      "http_proxy": null,
      "https_proxy": null,
      "no_proxy": ["localhost", "127.0.0.1"]
    }
  }
}