# Firecrawl 数据采集器环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ============================================
# Firecrawl API 配置（必需）
# ============================================
FIRECRAWL_API_KEY=fc-your-api-key-here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# ============================================
# 数据库配置
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=firecrawl
POSTGRES_USER=firecrawl_user
POSTGRES_PASSWORD=your-postgres-password

SQLITE_DB_PATH=./data/firecrawl.db

# ============================================
# Redis 配置
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ============================================
# 应用配置
# ============================================
APP_NAME=Firecrawl数据采集器
APP_VERSION=v2.1.0
APP_ENVIRONMENT=development
APP_DEBUG=true

# ============================================
# FastAPI 服务器配置
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FILE=firecrawl_collector.log

# ============================================
# 缓存配置
# ============================================
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_STORAGE_TYPE=memory

# ============================================
# 并发配置
# ============================================
MAX_CONCURRENT=10
BATCH_SIZE=20

# ============================================
# Firecrawl 性能优化
# ============================================
FIRECRAWL_MAX_AGE=172800000
FIRECRAWL_PROXY=basic
FIRECRAWL_TIMEOUT=120
FIRECRAWL_MAX_RETRIES=3
