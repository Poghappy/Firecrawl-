# EditorConfig 配置文件
# 确保跨编辑器的代码风格一致性
# https://editorconfig.org

root = true

# 所有文件默认配置
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python 文件
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

# YAML 文件
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON 文件
[*.json]
indent_style = space
indent_size = 2

# JSONC 文件（带注释的 JSON）
[*.jsonc]
indent_style = space
indent_size = 4

# Markdown 文件
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Shell 脚本
[*.sh]
indent_style = space
indent_size = 2

# Makefile
[Makefile]
indent_style = tab

# Docker 文件
[Dockerfile*]
indent_style = space
indent_size = 4

# TOML 文件
[*.toml]
indent_style = space
indent_size = 2

# INI 文件
[*.ini]
indent_style = space
indent_size = 2

# SQL 文件
[*.sql]
indent_style = space
indent_size = 2

# HTML/XML 文件
[*.{html,xml}]
indent_style = space
indent_size = 2

# CSS/SCSS 文件
[*.{css,scss}]
indent_style = space
indent_size = 2

# JavaScript/TypeScript 文件
[*.{js,ts,jsx,tsx}]
indent_style = space
indent_size = 2
