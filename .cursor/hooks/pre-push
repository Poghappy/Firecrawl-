#!/bin/bash

# Pre-push Hook - 完整质量检查
# 版本: v2.0.0

set -e

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${YELLOW}[Pre-Push]${NC} 执行完整质量检查..."

# 1. Prompts 配置验证
echo "1. 验证 Cursor Prompts 配置..."
if [ -f ".cursor/scripts/verify-prompts.sh" ]; then
    if bash .cursor/scripts/verify-prompts.sh; then
        echo -e "${GREEN}✓ Prompts 配置验证通过${NC}"
    else
        echo -e "${RED}✗ Prompts 配置验证失败${NC}"
        exit 1
    fi
fi

# 2. 代码质量检查（如果配置了）
if command -v make &> /dev/null && grep -q "lint" Makefile 2>/dev/null; then
    echo "2. 运行代码质量检查..."
    if make lint 2>/dev/null; then
        echo -e "${GREEN}✓ 代码质量检查通过${NC}"
    else
        echo -e "${YELLOW}⚠ 代码质量检查失败（继续）${NC}"
    fi
fi

# 3. 测试检查（如果配置了）
if command -v make &> /dev/null && grep -q "test" Makefile 2>/dev/null; then
    echo "3. 运行测试..."
    if make test 2>/dev/null; then
        echo -e "${GREEN}✓ 测试通过${NC}"
    else
        echo -e "${YELLOW}⚠ 测试失败（继续）${NC}"
    fi
fi

# 4. 检查敏感信息
echo "4. 检查敏感信息..."
if git diff origin/$(git branch --show-current) --name-only | xargs grep -l "sk-\|API_KEY\|SECRET" 2>/dev/null; then
    echo -e "${RED}✗ 发现可能的 API 密钥，请检查！${NC}"
    echo "如果这是 .env.example，请忽略此警告"
    # 不阻止 push，只是警告
fi

echo -e "${GREEN}✓ Pre-push 检查完成${NC}"
exit 0
